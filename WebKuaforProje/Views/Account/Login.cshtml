@model WebKuaforProje.Models.Musteri

@{
    ViewData["Title"] = "Oturum Aç";
}

<h1>Oturum Aç</h1>

<!-- Başarı mesajı -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<!-- Hata mesajı -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="Login" method="post">
    <div class="form-group">
        <label for="email">E-posta</label>
        <input id="email" name="Email" class="form-control" type="email" required />
        <small class="form-text text-muted">Lütfen geçerli bir e-posta adresi girin.</small>
    </div>
    <div class="form-group">
        <label for="password">Parola</label>
        <input id="password" name="Password" class="form-control" type="password" required />
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Oturum Aç" class="btn btn-primary" />
    </div>
</form>

<p class="mt-3">Hesabınız yok mu? <a href="@Url.Action("Register", "Account")">Kayıt Ol</a></p>
