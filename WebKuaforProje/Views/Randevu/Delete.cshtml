@using WebKuaforProje.Models

@model WebKuaforProje.Models.Randevu

@{
    ViewData["Title"] = "Randevu Sil";
}

<h2>Randevu Sil</h2>

<p>Randevuyu silmek istediğinizden emin misiniz?</p>

<div>
    <h4>@Model.Musteri.FullName</h4>
    <p>@Model.Hizmet - @Model.RandevuTarihi.ToString("yyyy-MM-dd")</p>
</div>

<form method="post">
    @csrf
    <input type="submit" value="Evet, sil" class="btn btn-danger" />
    <a href="@Url.Action("Index", "Randevu")" class="btn btn-secondary">Hayır, geri dön</a>
</form>
