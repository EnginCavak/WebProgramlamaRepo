@model WebKuaforProje.Models.Randevu

@{
    ViewData["Title"] = "Randevu Detayları";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Randevu</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Musteri)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Musteri.FirstName) @Html.DisplayFor(model => model.Musteri.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RandevuTarihi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RandevuTarihi)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Düzenle</a> |
    <a asp-action="Index">Listeye Dön</a>
</div>
