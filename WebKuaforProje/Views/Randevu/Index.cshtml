@using WebKuaforProje.Models

@model IEnumerable<WebKuaforProje.Models.Randevu>

@{
    ViewData["Title"] = "Randevular";
}

<h2>Randevular</h2>

@foreach (var randevu in Model)
{
    <div>
        <h3>@randevu.Musteri.FullName</h3>
        <p>@randevu.Hizmet - @randevu.RandevuTarihi.ToString("yyyy-MM-dd")</p>
        <a href="@Url.Action("Details", "Randevu", new { id = randevu.RandevuID })">Detaylar</a> |
        <a href="@Url.Action("Edit", "Randevu", new { id = randevu.RandevuID })">Düzenle</a> |
        <a href="@Url.Action("Delete", "Randevu", new { id = randevu.RandevuID })">Sil</a>
    </div>
}
